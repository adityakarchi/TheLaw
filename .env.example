# ── Legal AI Assistant — Environment Configuration ──
# Copy this file to .env and fill in your values.

# Required: Groq API key (free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Settings (optional — sensible defaults used) ──
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048

# ── Embedding Settings (optional) ──
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# ── RAG Settings (optional) ──
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVER_TOP_K=4

# Optional
DEBUG=false
